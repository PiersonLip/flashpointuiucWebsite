# Flashpoint Gear Rental — environment template
# Host-side scripts (migrations, seed) use localhost; the web container overrides DATABASE_URL to use the db service.
DATABASE_URL=postgresql://flashpoint:CHANGE_ME@127.0.0.1:5434/flashpoint_rentals
POSTGRES_PASSWORD=CHANGE_ME
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=https://rentals.flashpointuiuc.com
NEXT_PUBLIC_APP_URL=https://rentals.flashpointuiuc.com
BOOTSTRAP_MANAGER_EMAIL=pl45@illinois.edu
BOOTSTRAP_MANAGER_NAME=Pierson Lipschultz
BOOTSTRAP_MANAGER_NETID=pl45
BOOTSTRAP_MANAGER_PASSWORD=CHANGE_ME_MIN_8_CHARS
CRON_SECRET=generate-another-random-string
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# Discord channel webhook for manager alerts (optional)
DISCORD_WEBHOOK_URL=
# Optional override for gallery/board uploads (default: ./data/uploads)
# UPLOADS_DIR=/var/www/flashpoint/uploads
